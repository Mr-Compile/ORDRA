    <!-- About -->
    <string name="about_title">About</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_privacy">Ordra keeps orders, tracking numbers and receipts on your device. There is no account, no cloud sync, and no analytics collection. Smart Import can optionally use Groq to interpret screenshot text — nothing is sent without you asking.</string>
    <string name="about_licenses">Built with Jetpack Compose, Room, Hilt, WorkManager, ML Kit and Coil. Open-source licenses apply to those libraries.</string>
    <string name="about_ai_title">Ordi &amp; ORDRA AI</string>
    <string name="about_ai_body">Ordi is the companion face of ORDRA AI, Ordra\'s optional smart layer for features like screenshot import. Ordi only reflects your real order data — it never invents tracking updates or order details.</string>
